{
  "version": 2,
  "buildCommand": "cd backend && npm install && npm run build",
  "installCommand": "cd backend && npm install",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend/api"
    },
    {
      "source": "/health",
      "destination": "/backend/api"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}

