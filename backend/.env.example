# SiriLife Backend Environment Variables

# Server Port
PORT=3000
NODE_ENV=development

# Turso Database Configuration
# In production, use your Turso remote URL (e.g. libsql://your-db-org.turso.io)
# and generated authentication token from `turso db tokens create <database-name>`
# In local development, you can use a local SQLite file (e.g. file:./dev.db)
TURSO_DATABASE_URL=file:./dev.db
TURSO_AUTH_TOKEN=

# JWT Authentication Secret
JWT_SECRET=super-secret-sirilife-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=30d

# Allowed Origins for CORS (if calling from web dashboards or API testers)
ALLOWED_ORIGIN=*
